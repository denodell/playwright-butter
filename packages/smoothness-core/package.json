{
  "name": "smoothness-core",
  "version": "1.0.0",
  "description": "The measuring engine behind playwright-smoothness: frame, input and long-list smoothness checks in Chromium, driven through a small adapter interface.",
  "license": "MIT",
  "author": "Den Odell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denodell/playwright-smoothness.git",
    "directory": "packages/smoothness-core"
  },
  "homepage": "https://github.com/denodell/playwright-smoothness#readme",
  "bugs": {
    "url": "https://github.com/denodell/playwright-smoothness/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "performance",
    "jank",
    "smoothness",
    "chromium",
    "long-animation-frames",
    "event-timing"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "node ../../scripts/copy-package-docs.mjs smoothness-core"
  }
}
